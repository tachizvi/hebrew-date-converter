# HTTP port the service listens on
PORT=3000
# Base URL of the Hebcal converter endpoint
HEBCAL_BASE_URL=https://www.hebcal.com/converter
# Hebcal calendar endpoint (Israeli holidays for the workday rules)
HEBCAL_HOLIDAYS_URL=https://www.hebcal.com/hebcal
# Per-request timeout when calling Hebcal (ms)
HEBCAL_TIMEOUT_MS=5000
# How many extra attempts on network errors / 5xx
HEBCAL_RETRIES=1
# How long a conversion stays in the in-memory cache (ms) - default 24h
CACHE_TTL_MS=86400000
# Maximum number of cached conversions
CACHE_MAX_ENTRIES=1000
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
